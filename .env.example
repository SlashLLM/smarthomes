# Copy to .env.local for local dev; set the same keys in the Vercel project settings.
# None of these are VITE_-prefixed — they are read only by the serverless functions
# in api/ and must never reach the browser bundle.

# ---- Google Places (address autocomplete) ----
# Google Cloud console → enable "Places API (New)" → Credentials → API key.
# Billing must be enabled on the project. Restrict the key to the Places API.
GOOGLE_MAPS_API_KEY=

# ---- OpenAI (market rent + short-stay estimate) ----
# platform.openai.com → API keys
OPENAI_API_KEY=
# Optional. Defaults to the value in api/_lib/config.js.
# Must be a model that supports the Responses API web_search tool.
OPENAI_MODEL=
# Optional. Hard site-wide ceiling on billed model calls per UTC day, enforced in
# Postgres by try_consume_model_call. Defaults to 250 (~US$3.50/day at current
# per-call cost). Past the cap the calculator keeps serving cached and suburb
# answers instead of going dark.
MODEL_DAILY_BUDGET=

# ---- Supabase (estimate cache + leads) ----
# Supabase dashboard → Project Settings → API
SUPABASE_URL=
# The ANON (publishable) key — NOT the service role key. RLS is enabled with no
# policies on every table, so this key can only call the security definer RPCs
# granted to `anon` in supabase/migrations/0001_estimate_cache.sql.
SUPABASE_ANON_KEY=

# ---- Resend (lead notification email) ----
# resend.com → API keys
RESEND_API_KEY=
# Where lead notifications are delivered.
LEAD_TO_EMAIL=
# Must be on a domain you have verified in Resend.
LEAD_FROM_EMAIL=
